{
  "name": "common-corpus",
  "sourceRoot": "libs/common-corpus",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Build complete - common-corpus is ready'",
        "cwd": "libs/common-corpus"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test",
        "cwd": "libs/common-corpus"
      }
    },
    "build-layer": {
      "executor": "@nx/js:node",
      "options": {
        "command": "npm run build:layer",
        "cwd": "libs/common-corpus"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"**/*.js\" --ignore-path ../../.prettierignore",
        "cwd": "libs/common-corpus"
      }
    }
  }
}