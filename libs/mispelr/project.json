{
  "name": "mispelr",
  "sourceRoot": "libs/mispelr",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Build complete - node-mispelr is ready'",
        "cwd": "libs/mispelr"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test",
        "cwd": "libs/mispelr"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check index.js lib test --ignore-path ../../.prettierignore",
        "cwd": "libs/mispelr"
      }
    },
    "deploy:web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx gh-pages -d libs/mispelr/web --repo https://github.com/MichaelPaulukonis/mispelr.git --branch gh-pages"
      }
    }
  }
}
