{
  "name": "listmania",
  "sourceRoot": "apps/listmania",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/terraform/listmania-lambda.zip"],
      "options": {
        "command": "./build-lambda.sh",
        "cwd": "apps/listmania"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/terraform/listmania-lambda.zip"],
      "options": {
        "command": "./build-lambda.sh",
        "cwd": "apps/listmania"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test",
        "cwd": "apps/listmania"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:js",
        "cwd": "apps/listmania"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd terraform && terraform init -input=false",
          "cd terraform && terraform plan -input=false",
          "cd terraform && terraform apply -auto-approve"
        ],
        "cwd": "apps/listmania",
        "parallel": false
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd terraform && terraform init -input=false",
          "cd terraform && terraform plan -input=false"
        ],
        "cwd": "apps/listmania",
        "parallel": false
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm start",
        "cwd": "apps/listmania"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"**/*.js\" --ignore-path ../../.prettierignore",
        "cwd": "apps/listmania"
      }
    },
    "lambda:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node lambda/test-handler.js",
        "cwd": "apps/listmania"
      }
    }
  },
  "implicitDependencies": ["common-corpus"]
}
