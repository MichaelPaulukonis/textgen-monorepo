{
  "name": "poeticalbot",
  "sourceRoot": "apps/poeticalbot/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/terraform/poeticalbot-lambda.zip"],
      "options": {
        "command": "./build-lambda.sh",
        "cwd": "apps/poeticalbot"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/terraform/poeticalbot-lambda.zip"],
      "options": {
        "command": "./build-lambda.sh",
        "cwd": "apps/poeticalbot"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm test",
        "cwd": "apps/poeticalbot"
      }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:unit",
        "cwd": "apps/poeticalbot"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test:integration",
        "cwd": "apps/poeticalbot"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd terraform && terraform init -input=false",
          "cd terraform && terraform plan -input=false",
          "cd terraform && terraform apply -auto-approve"
        ],
        "cwd": "apps/poeticalbot",
        "parallel": false
      }
    },
    "deploy:plan": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "cd terraform && terraform init -input=false",
          "cd terraform && terraform plan -input=false"
        ],
        "cwd": "apps/poeticalbot",
        "parallel": false
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run cli:run",
        "cwd": "apps/poeticalbot"
      }
    },
    "repl": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run repl",
        "cwd": "apps/poeticalbot"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prettier --check \"**/*.js\" --ignore-path ../../.prettierignore",
        "cwd": "apps/poeticalbot"
      }
    }
  },
  "implicitDependencies": ["common-corpus"]
}